# Ambiente LOCAL. Copie para .env.local (ignorado pelo git).

# A API que o site consome. Apontar para localhost tem um efeito extra:
# o formulário de cartão pré-preenche o cartão de teste do Asaas sandbox
# (ver src/app/reservar/[code]/page.tsx, constante DEV).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base dos endereços canônicos e do sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Na Vercel, NEXT_PUBLIC_API_URL deve ficar SÓ no ambiente Production.
# Marcada em "All Environments", o preview de qualquer branch passa a falar com
# a API de produção, e testar no preview vira reserva de cliente de verdade.
# ─────────────────────────────────────────────────────────────────────────────
